# Kopieren nach .env und ausfüllen. .env wird nicht eingecheckt.
# Die öffentliche Adresse steht in src/config.ts (PUBLIC_URL), nicht hier.

# Messung nur auf der Startseite, ohne Cookies: Cloudflare Web Analytics.
# Leer lassen = aus (Standard). Den Token gibt es in Cloudflare unter «Web Analytics».
# Der Build nimmt Cloudflare dann automatisch in die CSP auf.
VITE_CF_ANALYTICS_TOKEN=
