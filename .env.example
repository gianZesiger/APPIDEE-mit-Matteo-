# Kopieren nach .env und ausfüllen. .env wird nicht eingecheckt.

# Öffentliche Adresse ohne Schrägstrich am Ende. Nötig für canonical, OG-Bild und sitemap.xml.
# [[BITTE AUSFÜLLEN]]
VITE_SITE_URL=

# Messung nur auf der Landingpage, ohne Cookies. Leer lassen = aus (Standard).
# Umami:     VITE_ANALYTICS=umami      VITE_ANALYTICS_SRC=https://<dein-umami>/script.js  VITE_ANALYTICS_ID=<website-id>
# Plausible: VITE_ANALYTICS=plausible  VITE_ANALYTICS_SRC=https://plausible.io/js/script.js  VITE_ANALYTICS_ID=<domain>
# Der Build nimmt den Host von VITE_ANALYTICS_SRC automatisch in die CSP (dist/_headers) auf.
VITE_ANALYTICS=
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_ID=
